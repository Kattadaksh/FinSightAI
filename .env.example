# ==============================================================================
# FinSight AI — Environment Example Template
# Copy this file to `.env` in the project root and populate your API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Backend & System Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=finsight_dev_secret_key_9f8d7e6c5b4a321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. Data Store Services (Local / Docker Compose)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# 4. Financial & News Data Provider API Keys
# ------------------------------------------------------------------------------
# SEC EDGAR (Primary Source - NO API KEY REQUIRED. Keep User-Agent header below)
SEC_EDGAR_USER_AGENT=FinSightAI research@finsight.ai

# Alpha Vantage (Primary News & Sentiment - Get free key at https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=demo

# Polygon.io (Primary Market Data - Optional)
POLYGON_API_KEY=your_polygon_api_key

# Finnhub (Supplementary Data Provider - Optional)
FINNHUB_API_KEY=your_finnhub_api_key

# ------------------------------------------------------------------------------
# 5. LLM Provider API Keys (LangGraph Multi-Agent Engine)
# ------------------------------------------------------------------------------
# OpenAI (Get key at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# Google Gemini (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude (Get key at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key
